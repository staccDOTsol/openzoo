{
  "name": "openzoo-grokui",
  "version": "1.3.8",
  "private": true,
  "description": "Standalone desktop chat client — same message canvas as Grok Bot, backed by openzoo.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --arm64 --x64",
    "dist:linux": "electron-builder --linux --arm64 --x64",
    "dist:win": "electron-builder --win --arm64 --x64",
    "dist:all": "electron-builder -mwl --arm64 --x64"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fun.openzoo.grokui",
    "productName": "openzoo",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "!**/node_modules/**/{test,__tests__}/**",
      "build/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "Network",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "afterPack": "build/afterPack.js",
    "npmRebuild": false,
    "includeSubNodeModules": true
  },
  "dependencies": {
    "openzoo": "^0.44.1"
  },
  "overrides": {
    "uuid": "^8.3.2"
  }
}
