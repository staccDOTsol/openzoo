{
  "name": "openzoo-grokui",
  "version": "1.6.7",
  "private": true,
  "description": "Standalone desktop chat client \u2014 same message canvas as Grok Bot, backed by openzoo.",
  "main": "main.js",
  "scripts": {
    "bundle-ui": "node scripts/bundle-grokui.js",
    "start": "node scripts/bundle-grokui.js && electron .",
    "dist:mac": "node ../scripts/assert-grokui-pin.mjs && node scripts/bundle-grokui.js && electron-builder --mac --arm64 --x64",
    "dist:linux": "node ../scripts/assert-grokui-pin.mjs && node scripts/bundle-grokui.js && electron-builder --linux --arm64 --x64",
    "dist:win": "node ../scripts/assert-grokui-pin.mjs && node scripts/bundle-grokui.js && electron-builder --win --arm64 --x64",
    "dist:all": "node ../scripts/assert-grokui-pin.mjs && node scripts/bundle-grokui.js && electron-builder -mwl --arm64 --x64"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fun.openzoo.grokui",
    "productName": "openzoo",
    "asar": false,
    "files": [
      "main.js",
      "sidecar-version.js",
      "sidecar-heal.js",
      "preload.js",
      "lib/**/*",
      "build/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "Network",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "afterPack": "build/afterPack.js",
    "npmRebuild": true,
    "includeSubNodeModules": true,
    "extraResources": [
      {
        "from": "node_modules/node-pty",
        "to": "node-pty"
      },
      {
        "from": "node_modules/openzoo-claude",
        "to": "openzoo-claude"
      }
    ]
  },
  "dependencies": {
    "node-pty": "1.1.0",
    "openzoo-claude": "2.0.2",
    "@solana/codecs-core": "^2.0.0-rc.1",
    "@solana/codecs-data-structures": "^2.0.0-rc.1",
    "@solana/codecs-numbers": "^2.0.0-rc.1",
    "@solana/codecs-strings": "^2.0.0-rc.1",
    "@solana/errors": "^2.0.0-rc.1",
    "@solana/spl-token-group": "^0.0.7",
    "@solana/spl-token-metadata": "^0.1.6",
    "dugite": "^3.2.3",
    "openzoo": "latest",
    "viem": "^2.55.17"
  },
  "overrides": {
    "uuid": "^8.3.2"
  }
}
